{
  "collectionName": "components_shared_pdfs",
  "info": {
    "displayName": "PDFs"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": false
    },
    "col": {
      "type": "integer",
      "required": true,
      "default": 6
    },
    "category": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category-pdf.category-pdf"
    },
    "type": {
      "type": "string",
      "private": true,
      "default": "pdf"
    },
    "pdf": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "files"
      ]
    },
    "dowload": {
      "type": "integer"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "color_bottom": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    }
  },
  "config": {}
}
