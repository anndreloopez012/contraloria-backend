{
  "collectionName": "components_shared_rich_texts",
  "info": {
    "displayName": "Contenido",
    "icon": "align-justify",
    "description": ""
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "col": {
      "type": "integer",
      "required": true,
      "default": 6
    },
    "type": {
      "type": "string",
      "private": true,
      "default": "content"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "opciones"
      ]
    },
    "content": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultMarkdown"
      }
    }
  }
}
