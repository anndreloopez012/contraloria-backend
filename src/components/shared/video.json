{
  "collectionName": "components_shared_videos",
  "info": {
    "displayName": "Videos"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text"
    },
    "col": {
      "type": "integer",
      "required": true,
      "default": 6
    },
    "type": {
      "type": "string",
      "private": true,
      "default": "video"
    },
    "video": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "iframe": {
      "type": "customField",
      "customField": "plugin::oembed.oembed",
      "displayName": "Iframe"
    }
  },
  "config": {}
}
