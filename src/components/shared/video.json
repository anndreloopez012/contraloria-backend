{
  "collectionName": "components_shared_videos",
  "info": {
    "displayName": "Video"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "col": {
      "type": "integer",
      "required": true,
      "default": 6
    },
    "type": {
      "type": "string",
      "private": true,
      "default": "video"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "opciones"
      ]
    },
    "video": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "videos"
      ]
    },
    "enlace": {
      "type": "customField",
      "customField": "plugin::video-field.video"
    },
    "iframe": {
      "type": "customField",
      "customField": "plugin::oembed.oembed"
    }
  },
  "config": {}
}
