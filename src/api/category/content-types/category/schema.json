{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Categorías",
    "description": "Organiza tu contenido en categorías"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "configurable": true,
      "displayName": "Nombre"
    },
    "slug": {
      "type": "uid",
      "configurable": true,
      "displayName": "Slug"
    },
    "articles": {
      "type": "relation",
      "configurable": true,
      "displayName": "Artículos",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "category"
    },
    "description": {
      "type": "text",
      "configurable": true,
      "displayName": "Descripción"
    }
  }
}