{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Páginas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::menu-item.menu-item",
      "displayName": "Enlace del menú"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "block": {
      "type": "dynamiczone",
      "components": [
        "shared.video",
        "shared.rich-text",
        "shared.pdf",
        "shared.image"
      ]
    }
  }
}
