{
  "kind": "collectionType",
  "collectionName": "menu_items",
  "info": {
    "singularName": "menu-item",
    "pluralName": "menu-items",
    "displayName": "Menú Opciones",
    "description": "Elemento individual del menú con soporte para niveles infinitos"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "menu": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::menu.menu",
      "displayName": "Menú",
      "inversedBy": "items"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu-item.menu-item",
      "displayName": "Subítems",
      "mappedBy": "parent"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": false
    },
    "route": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "target_blank": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::menu-item.menu-item",
      "displayName": "Padre",
      "inversedBy": "children"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "text_color": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "text_color_hover": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    }
  }
}
