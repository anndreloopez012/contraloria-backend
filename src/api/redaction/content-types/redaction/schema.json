{
  "kind": "collectionType",
  "collectionName": "redactions",
  "info": {
    "singularName": "redaction",
    "pluralName": "redactions",
    "displayName": "Redaccion"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "author": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::author.author",
      "mappedBy": "redaccion"
    },
    "SEO": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "block": {
      "type": "dynamiczone",
      "components": [
        "shared.pdf",
        "shared.video",
        "shared.rich-text",
        "shared.image",
        "shared.audio"
      ]
    }
  }
}
