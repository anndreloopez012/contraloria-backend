HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Seguridad
CORS_ORIGIN=https://adm-cms.contraloria.gob.gt,https://app1.contraloria.gob.gt,https://app2.contraloria.gob.gt,https://app3.contraloria.gob.gt,https://app4.contraloria.gob.gt,https://dev.contraloria.gob.gt,https://contraloria.gob.gt
ADMIN_COOKIE_SECURE=true
CSRF_ENABLED=true
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_SECURE=true

# Backups automáticos
BACKUP_ENABLED=true
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups
BACKUP_DOCUMENTS_PATHS=public/uploads,data/uploads
BACKUP_RUN_ON_START=false

# Modo mantenimiento
MAINTENANCE_ENABLED=true
MAINTENANCE_FORCE_DISABLED=false
MAINTENANCE_CACHE_MS=10000
MAINTENANCE_RETRY_AFTER=3600
